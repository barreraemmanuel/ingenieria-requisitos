# Configuración de producción de la receta de serie (runbooks/deploy-vps-docker.md).
# NO se rellena a mano: lo escribe `python3 docs/00-metodo/scripts/vps.py env`, que pregunta
# lo que solo sabes tú e inventa los secretos. El fichero de verdad vive en
# `.private/produccion.env` (modo 0600) y JAMÁS entra en git ni en docs.

# El dominio que ya tienes en Cloudflare, sin https:// y sin www (paso 2 del runbook).
DOMINIO=ejemplo.com
# La IP pública que te dio el proveedor al crear el VPS (paso 5).
VPS_IP=203.0.113.10
# El usuario con el que entras por SSH al VPS: root, ubuntu o el que creaste (paso 5).
VPS_USUARIO=desplegador
# Nombre:etiqueta de la imagen Docker de TU aplicación; se construye en tu portátil (paso 9).
APP_IMAGEN=miapp:prod
# Nombre de la base de datos de la aplicación dentro de Postgres.
POSTGRES_DB=miapp
# Usuario dueño de esa base de datos.
POSTGRES_USER=miapp
# Contraseña de ese usuario: la inventa el script, no la teclees ni la copies a ningún sitio.
POSTGRES_PASSWORD=<lo inventa vps.py env>
# Clave de firma de TU aplicación (sesiones, cookies): la inventa el script.
SECRET_KEY=<lo inventa vps.py env>
# Clave de firma de Bugsink (mínimo 50 caracteres): la inventa el script.
BUGSINK_SECRET_KEY=<lo inventa vps.py env>
# Usuario administrador de Bugsink en formato correo:contraseña; tú das el correo (paso 10).
BUGSINK_SUPERUSER=yo@ejemplo.com:<lo inventa vps.py env>
# Dirección a la que tu aplicación manda los errores; la copias de Bugsink en el paso 10.
SENTRY_DSN=
# URL del latido de Better Stack que avisa si el backup deja de correr; se copia en el paso 11.
HEARTBEAT_URL=
# Remote cifrado de rclone donde caen las copias, con su carpeta (paso 12).
RCLONE_REMOTE=copias-cifradas:miapp
